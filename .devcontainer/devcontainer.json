{
  "name": "building-energy-standards-data",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "postCreateCommand": "pip install poetry==1.7.1 && poetry install --with agent && poetry install --with fine_tuning && poetry run python building_energy_standards_data/setup_database.py",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3.11"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "workspaceFolder": "/workspaces/building-energy-standards-data"
}
